{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"ignore": [
			"src/routeTree.gen.ts",
			"src/client/**",
			"e2e/runtime/.local/**"
		],
		"include": [
			"src/*",
			".vscode/*",
			"index.html",
			"vite.config.js",
			"playwright*.config.ts",
			"e2e/**",
			".storybook/**",
			"vitest.workspace.ts",
			"scripts/*.mjs"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
