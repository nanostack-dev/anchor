{
  "name": "anchor-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "openapi-ts": "openapi-ts",
    "start": "vite --port 3000",
    "build": "vite build",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "typecheck:app": "tsc",
    "serve": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "test-storybook": "vitest --config vitest.workspace.ts run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check && pnpm check:ui",
    "storybook": "storybook dev -p 6007 --ci",
    "build-storybook": "storybook build",
    "check:ui": "node scripts/check-ui-contract.mjs",
    "ui-shot": "node scripts/ui-shot.mjs",
    "test:e2e:app": "playwright test --config playwright.app.config.ts",
    "test:e2e:ui": "playwright test --config playwright.app.config.ts --ui --ui-host=127.0.0.1 --ui-port=9351"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@nanostackorg/design-system": "0.2.4",
    "@phosphor-icons/react": "^2.1.10",
    "@standard-schema/spec": "^1.0.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-form": "^1.0.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-devtools": "^5.83.0",
    "@tanstack/react-router": "^1.114.35",
    "@tanstack/react-router-devtools": "^1.114.3",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/router-plugin": "^1.114.3",
    "@uidotdev/usehooks": "^2.4.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.476.0",
    "motion": "^12.42.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@hey-api/openapi-ts": "^0.83.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "jsdom": "^26.0.0",
    "playwright": "1.60.0",
    "storybook": "^10.5.5",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vitest": "^4.1.10",
    "web-vitals": "^4.2.4",
    "wrangler": "^4.135.0"
  },
  "packageManager": "pnpm@11.1.0"
}
