pub description = "Anchor's checks: Go tests with a Docker daemon, the anchor-ui frontend, the lint tooling and the image"

"""
Anchor's CI, the same shape as echopoint's module. Checks read the whole
repository minus build output, mounted at /repo (not /src: Biome 1.9 matches
anchor-ui's include glob "src/*" against absolute paths): this repository runs on GitHub-hosted runners,
where every run starts cold, so narrower inputs would save nothing.
"""
type Anchor {
  """
  Go toolchain image. Keep it equal to the toolchain line in apps/anchor/go.mod.
  """
  pub goImage: String!

  """
  Playwright image matching anchor-ui's playwright package.
  """
  pub playwrightImage: String!

  """
  pnpm release for the workspace.
  """
  pub pnpmVersion: String!

  """
  Go release for the test container's toolchain, as in apps/anchor/go.mod.
  """
  pub goVersion: String!

  new(
    goImage: String! = "golang:1.27.3-bookworm",
    playwrightImage: String! = "mcr.microsoft.com/playwright:v1.60.0-noble",
    pnpmVersion: String! = "11.1.0",
    goVersion: String! = "1.27.3",
  ) {
    self.goImage = goImage
    self.playwrightImage = playwrightImage
    self.pnpmVersion = pnpmVersion
    self.goVersion = goVersion
    self
  }

  """
  The repository minus dependencies and build output.
  """
  pub source(ws: Workspace!): Directory! {
    ws.directory(
      "/",
      exclude: [
        ".git",
        ".dagger",
        "dagger.toml",
        "dagger.lock",
        "**/node_modules",
        "anchor-ui/dist",
        "anchor-ui/storybook-static",
        "anchor-ui/test-results",
      ],
    )
  }

  """
  The Go test container: Go on the Docker image, so each test run starts its
  own daemon inside the container. Every port testcontainers publishes is on
  localhost, which the SMTP client requires before it sends PLAIN auth over
  the unencrypted Mailpit connection, and bind mounts resolve on the same
  filesystem.
  """
  pub goTestBase(ws: Workspace!): Container! {
    container
      .from("docker:29-dind")
      .withExec(["apk", "add", "--no-cache", "git", "bash"])
      .withDirectory("/usr/local/go", container.from("golang:" + goVersion + "-alpine").directory("/usr/local/go"))
      .withEnvVariable("PATH", "/usr/local/go/bin:/root/go/bin:${PATH}", expand: true)
      .withEnvVariable("CGO_ENABLED", "0")
      .withMountedCache("/root/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      # dockerd needs a real filesystem for its overlay storage.
      .withMountedCache("/var/lib/docker", cacheVolume("anchor-test-docker"), sharing: CacheSharingMode.PRIVATE)
      .withExec(["go", "install", "gotest.tools/gotestsum@v1.13.0"])
      .withEnvVariable("TESTCONTAINERS_RYUK_DISABLED", "true")
      .withDirectory("/repo", source(ws))
  }

  let goTests(ws: Workspace!, dir: String!): Void {
    goTestBase(ws)
      .withWorkdir("/repo/apps/anchor/" + dir)
      .withExec(
        ["sh", "-c", "dockerd > /tmp/dockerd.log 2>&1 & for i in $(seq 60); do docker info > /dev/null 2>&1 && break; sleep 1; done; docker info > /dev/null || { cat /tmp/dockerd.log; exit 1; }; gotestsum --format pkgname-and-test-fails -- ./..."],
        insecureRootCapabilities: true,
      )
      .sync
    null
  }

  """
  golangci-lint over apps/anchor with the repository-root configuration, as
  scripts/lint.sh runs it: the ruleguard rules in .golangci.yml are paths
  relative to apps/anchor.
  """
  lint(ws: Workspace!): Void @check {
    container
      .from(goImage)
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/repo", source(ws))
      .withWorkdir("/repo/apps/anchor")
      # Module downloads stay outside golangci-lint's own timeout.
      .withExec(["go", "mod", "download"])
      # The linter pinned in the tool module, built as local runs build it
      # (scripts/lint.sh). The first call builds it, outside the lint timeout,
      # and prints the version.
      .withExec(["go", "tool", "-modfile=tools/golangci-lint/go.mod", "golangci-lint", "version"])
      # 15 m: the 5 m budget timed out on 4 vCPU runners (5m18s and 9m14s
      # runs) when a ruleguard rule made a cold lint take 353 s.
      .withExec(["go", "tool", "-modfile=tools/golangci-lint/go.mod", "golangci-lint", "run", "--config", "../../.golangci.yml", "--path-mode=abs", "--timeout", "15m", "--allow-serial-runners", "./..."])
      .sync
    null
  }

  """
  Every second top-level test of a package, so one suite splits over two
  runners. Test names come from the sources: `go test -list` would run
  TestMain, which starts the containers. shard is 0 or 1. It fails unless
  every selected test ran, so a name the filter misses cannot pass silently.
  """
  let goTestsHalf(ws: Workspace!, dir: String!, shard: String!): Void {
    goTestBase(ws)
      .withWorkdir("/repo/apps/anchor/" + dir)
      .withExec(
        ["sh", "-c", "dockerd > /tmp/dockerd.log 2>&1 & for i in $(seq 60); do docker info > /dev/null 2>&1 && break; sleep 1; done; docker info > /dev/null || { cat /tmp/dockerd.log; exit 1; }; tests=$(grep -hoE '^func Test[A-Za-z0-9_]+\\(t \\*testing\\.T\\)' *_test.go | sed -E 's/^func (Test[A-Za-z0-9_]+).*/\\1/' | sort -u | awk 'NR % 2 == " + shard + "' | paste -sd'|' -); test -n \"$tests\"; rc=0; gotestsum --format pkgname-and-test-fails --jsonfile /tmp/tests.json -- -run \"^($tests)\\$\" . || rc=$?; want=$(echo \"$tests\" | tr '|' '\\n' | wc -l); ran=$(grep -oE '\"Action\":\"(pass|skip)\",\"Package\":\"[^\"]*\",\"Test\":\"Test[^/\"]*\"' /tmp/tests.json | wc -l); echo \"ran $ran of $want selected tests\"; test \"$ran\" -eq \"$want\" || exit 1; exit $rc"],
        insecureRootCapabilities: true,
      )
      .sync
    null
  }

  """
  Component tests (apps/anchor/cmd/it/ct), first half: the suite is the
  longest check (4m35s on a cold 4 vCPU runner), so CI runs the halves on two
  runners. Together the halves run every test.
  """
  componentTestsA(ws: Workspace!): Void @check { goTestsHalf(ws, "cmd/it/ct", "0") }

  """
  Component tests (apps/anchor/cmd/it/ct), second half.
  """
  componentTestsB(ws: Workspace!): Void @check { goTestsHalf(ws, "cmd/it/ct", "1") }

  """
  Service tests (apps/anchor/cmd/it/service).
  """
  serviceTests(ws: Workspace!): Void @check { goTests(ws, "cmd/it/service") }

  """
  Unit tests (apps/anchor/internal).
  """
  unitTests(ws: Workspace!): Void @check { goTests(ws, "internal") }

  """
  Wiring tests (apps/anchor/cmd/app): the generated wiring and config binder
  match the manifest and Config (nanostack gen wire/config -check), and the
  committed YAML layers bind.
  """
  wiringTests(ws: Workspace!): Void @check { goTests(ws, "cmd/app") }

  """
  Generated code (apps/anchor): every file that nanostack gen writes matches its
  inputs. -fresh ignores nanogen.sum and applies the migrations to a new
  database, so the go-jet models are proven against the migrations, not only
  against the recorded checksums.

  The database is a service of the image that nanogen/project.go declares,
  named by NANO_GEN_DATABASE_URL. nanostack gen does not start its own container
  here: timescaledb-tune reads the container's memory.max, which a nested
  Docker daemon does not provide, and Postgres exits with code 2.
  NO_TS_TUNE skips the tuning, as cmd/it/shared/test_setup.go does.
  """
  generatedCode(ws: Workspace!): Void @check {
    let db = container
      .from("timescale/timescaledb:2.23.0-pg18")
      .withEnvVariable("POSTGRES_PASSWORD", "nanogen")
      .withEnvVariable("NO_TS_TUNE", "true")
      .withExposedPort(5432)
      .asService
    container
      .from(goImage)
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/repo", source(ws))
      .withWorkdir("/repo/apps/anchor")
      .withServiceBinding("db", db)
      .withEnvVariable("GOWORK", "off")
      .withEnvVariable("NANO_GEN_DATABASE_URL", "postgres://postgres:nanogen@db:5432/postgres?sslmode=disable")
      .withExec(["go", "tool", "nanostack", "gen", "-check", "-fresh", "-diff"])
      .sync
    null
  }

  """
  The lint wrapper's command boundary (scripts/lint.sh) behaves as tested.
  """
  lintTooling(ws: Workspace!): Void @check {
    container
      .from("python:3.13-bookworm")
      .withDirectory("/repo", source(ws))
      .withDirectory("/repo", ws.directory("/", include: [".dagger/modules/anchor/main.dang"]))
      .withWorkdir("/repo")
      .withExec(["python3", "scripts/test_lint.py"])
      .sync
    null
  }

  """
  anchor-ui with the workspace's dependencies installed. The install layer
  depends only on the manifests and lockfile.
  """
  pub frontend(ws: Workspace!): Container! {
    container
      .from(playwrightImage)
      .withExec(["npm", "install", "--global", "pnpm@" + pnpmVersion])
      .withEnvVariable("npm_config_store_dir", "/pnpm-store")
      .withMountedCache("/pnpm-store", cacheVolume("anchor-pnpm-store"))
      .withEnvVariable("CI", "true")
      .withEnvVariable("VITE_API_BASE_URL", "https://apidev.tryanchor.dev")
      .withDirectory("/repo", ws.directory("/", include: ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", ".npmrc", "anchor-ui/package.json", "anchor-ui/.npmrc"]))
      .withWorkdir("/repo")
      .withExec(["pnpm", "install", "--frozen-lockfile"])
      .withDirectory("/repo", source(ws))
      .withWorkdir("/repo/anchor-ui")
      .withMountedTemp("/dev/shm", size: 2147483648)
  }

  """
  anchor-ui's API client, generated from the OpenAPI document. `dagger
  generate` writes it; its stale check fails when the committed client differs.
  """
  apiClient(ws: Workspace!): Changeset! @generate {
    let path = "anchor-ui/src/client"
    let generated = frontend(ws).withExec(["pnpm", "openapi-ts"]).directory("/repo/" + path)
    directory.withDirectory(path, generated).changes(directory.withDirectory(path, ws.directory(path)))
  }

  """
  Biome, the UI contract and the E2E inventory (pnpm check).
  """
  frontendCheck(ws: Workspace!): Void @check {
    frontend(ws).withExec(["pnpm", "check"]).sync
    null
  }

  """
  TypeScript type check.
  """
  frontendTypecheck(ws: Workspace!): Void @check {
    frontend(ws).withExec(["pnpm", "typecheck"]).sync
    null
  }

  """
  Unit tests (Vitest).
  """
  frontendTest(ws: Workspace!): Void @check {
    frontend(ws).withExec(["pnpm", "test"]).sync
    null
  }

  """
  Production build.
  """
  frontendBuild(ws: Workspace!): Void @check {
    frontend(ws).withExec(["pnpm", "build"]).sync
    null
  }

  """
  Storybook interaction tests in Chromium.
  """
  storybookTest(ws: Workspace!): Void @check {
    frontend(ws).withExec(["pnpm", "test-storybook"]).sync
    null
  }

  """
  The image, built from the Dockerfile.
  """
  pub image(
    ws: Workspace!,
    version: String! = "dev",
    commitSha: String! = "unknown",
    buildDate: String! = "",
  ): Container! {
    source(ws)
      .dockerBuild(
        dockerfile: "Dockerfile",
        platform: "linux/amd64",
        buildArgs: [
          {{name: "VERSION", value: version}},
          {{name: "COMMIT_SHA", value: commitSha}},
          {{name: "BUILD_DATE", value: buildDate}},
        ],
      )
      .withLabel("org.opencontainers.image.revision", commitSha)
      .withLabel("org.opencontainers.image.version", version)
  }

  """
  The Dockerfile builds.
  """
  imageBuilds(ws: Workspace!): Void @check {
    image(ws).sync
    null
  }

  """
  Push the image under each tag and return the pushed references.
  """
  pub publish(
    ws: Workspace!,
    repository: String!,
    tags: [String!]!,
    username: String!,
    password: Secret!,
    version: String! = "dev",
    commitSha: String! = "unknown",
    buildDate: String! = "",
  ): [String!]! {
    let built = image(ws, version: version, commitSha: commitSha, buildDate: buildDate)
      .withRegistryAuth(repository, username, password)
    tags.map { tag => built.publish(repository + ":" + tag) }
  }
}
