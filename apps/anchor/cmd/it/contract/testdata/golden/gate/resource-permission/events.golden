# anchor: resource-permission / Anchor Emitted Every Resource Permission Event
deliveries: 8

header Accept-Encoding: gzip
header Content-Type: application/json
header User-Agent: Go-http-client/1.1
header Webhook-Id: pevt_<id>
header Webhook-Signature: v1,<base64>
header Webhook-Timestamp: <unix-seconds>
body:
{"type":"product.resource_permission.created","timestamp":"<timestamp.frac>","data":{"permission_name":"eptestdoc:read"}}
<no trailing newline>

