# anchor: product user external id / Evaluate By external_id (allow, role + email)
request: POST /v1/products/{{create-product.productId}}/access/v1/evaluation
request-headers: Content-Type, X-Product-Api-Key
request-body: {"subject": {"type": "user", "id": "ext-{{$runId}}"}, "resource": {"type": "organization", "id": "{{org.orgId}}"}, "action": {"name": "ext:read"}}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/product-user-external-id/eval-allow
header-names: Content-Type, Vary, X-Request-Id

body:
{"context":{"organization":{"id":"{{org.orgId}}","name":"eptest-extid-{{$runId}}"},"permissions":["ext:read"],"product_user":{"email":"{{user-a.email}}","id":"{{user-a.id}}","name":"eptest a"},"role":{"id":"{{role.rid}}","name":"eptest-ext-reader"}},"decision":true}

logs: 1 line(s)
