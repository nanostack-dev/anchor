request: GET /v1/products/{{create-product.productId}}
request-headers: Content-Type

status: 401
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/product/no-credential
header-names: Content-Type, Vary, X-Request-Id

body:
{"errors":[{"code":"UNAUTHORIZED","message":"Unauthorized"}]}

logs: 0 line(s)
