request-body: {"role_ids": ["{{role-doc-viewer.id}}"], "resource": {"name": "Memo", "parent": {"type": "folder", "id": "design"}}}

status: 403
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/register-on-assign-organization-role-scope/reg-no-write-scope
header-names: Content-Type, Vary, X-Request-Id

