# anchor: invitations / Accept S2
request: POST /v1/products/{{create-product.productId}}/organizations/{{create-org-search.orgId}}/invitations/{{invite-s2.invitationId}}/accept
request-headers: Content-Type, X-Product-Api-Key
request-body: {"product_user_id": "{{create-bystander.userId}}"}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/invitations/accept-s2
header-names: Content-Type, Vary, X-Request-Id

body:
{"accepted_at":"<timestamp.frac>","created_at":"<timestamp.frac>","email":"{{invite-s2.email}}","expires_at":"<timestamp.frac>","id":"{{invite-s2.invitationId}}","organization_id":"{{create-org-search.orgId}}","role_id":"{{create-role.roleId}}","status":"accepted","updated_at":"<timestamp.frac>"}

logs: 1 line(s)
{"api_key_id":"product_apikey_<id>","api_key_name":"eptest-invitations-key","bytes_out":"<int:=body-length>","caller":"/<path>/<file>.go:<line>","client_ip":"<ip>","duration":"<duration:number:ms>","env":"development","level":"info","message":"POST /v1/products/{{create-product.productId}}/organizations/{{create-org-search.orgId}}/invitations/{{invite-s2.invitationId}}/accept -> 200 (<duration>)","method":"POST","path":"/v1/products/{{create-product.productId}}/organizations/{{create-org-search.orgId}}/invitations/{{invite-s2.invitationId}}/accept","principal_type":"api_key","request_body":"<present>","request_id":"ct/invitations/accept-s2","status":200,"tenant_id":"tenant_<id>","time":"<time:timestamp>","user_agent":"anchor-contract/1"}
