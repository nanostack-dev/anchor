# anchor: product event delivery / Subscribe To An Unknown Type (400)
request: POST /v1/products
request-headers: Authorization, Content-Type
request-body: {"name":"eptest-evt-unknown-{{$runId}}","config":{"events":{"endpoint_url":"{{webhook.url}}","events":["nonexistent.event"]}}}

status: 400
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/product-event-delivery/unknown-event
