# anchor: email-templates / Product Key Sends use_draft (403 EMAIL_DRAFT_SEND_FORBIDDEN)
request: POST /v1/products/{{create-product.productId}}/email/sends
request-headers: Content-Type, X-Product-Api-Key
request-body: {"template_slug": "eptest-nope-{{$runId}}", "to_address": "garbage+draft-{{$runId}}@nanostack.dev", "use_draft": true}

status: 403
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/email-templates/send-draft-by-key
header-names: Content-Type, Vary, X-Request-Id

body:
{"errors":[{"code":"EMAIL_DRAFT_SEND_FORBIDDEN","message":"A product API key sends the published version; use_draft needs a platform user."}]}

