# anchor: cursor searches — organizations & members / Organizations by name (all tie): page 2 of 2 has next_cursor
request: POST /v1/products/{{create-product.productId}}/organizations/search
request-headers: Content-Type, X-Product-Api-Key
request-body: {"sort_by":"name","sort_direction":"ASC","pagination":{"limit":2,"cursor":"{{orgs-by-name-p1.cursor}}"}}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/cursor-searches-organizations-members/orgs-by-name-p2
header-names: Content-Type, Vary, X-Request-Id

body:
<shape: every item has the same name, so the order (and the page an item lands on) follows the random id tie-break>
{"count":"\u003cnumber\u003e","items":[{"created_at":"\u003cstring\u003e","id":"\u003cstring\u003e","name":"\u003cstring\u003e","product_id":"\u003cstring\u003e","updated_at":"\u003cstring\u003e"},{"created_at":"\u003cstring\u003e","id":"\u003cstring\u003e","name":"\u003cstring\u003e","product_id":"\u003cstring\u003e","updated_at":"\u003cstring\u003e"}],"next_cursor":"\u003cstring\u003e","total":"\u003cnumber\u003e"}

