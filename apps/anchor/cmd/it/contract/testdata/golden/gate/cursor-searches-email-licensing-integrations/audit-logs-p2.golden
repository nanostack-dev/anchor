# anchor: cursor searches — email & licensing & integrations / Integration audit logs: page 2 by cursor is the last (no next_cursor)
request: POST /v1/products/{{create-product.productId}}/integrations/{{integration.id}}/audit-logs/search
request-headers: Authorization, Content-Type
request-body: {"pagination":{"limit":2,"cursor":"{{audit-logs-p1.cursor}}"}}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/cursor-searches-email-licensing-integrations/audit-logs-p2
header-names: Content-Type, Vary, X-Request-Id

