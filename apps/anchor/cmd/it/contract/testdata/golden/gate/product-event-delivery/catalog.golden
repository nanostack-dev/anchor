{"items":[{"description":"Emitted for each role a member stops holding on a resource: removed, left the organization, or the resource deleted.","group_name":"Resources","group_type":"internal","name":"Resource role removed","type":"resource.role_assignment.deleted"},{"description":"Emitted when a member gets a role on a resource where they held none.","group_name":"Resources","group_type":"internal","name":"Resource role assigned","type":"resource.role_assignment.created"},{"description":"Emitted when a member is added to an organization.","group_name":"Organizations","group_type":"internal","name":"Membership created","type":"organization.membership.created"},{"description":"Emitted when a member's role on a resource is replaced.","group_name":"Resources","group_type":"internal","name":"Resource role changed","type":"resource.role_assignment.updated"},{"description":"Emitted when a new organization is created.","group_name":"Organizations","group_type":"internal","name":"Organization created","type":"organization.created"},{"description":"Emitted when a product role is created.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Role created","type":"product.role.created"},{"description":"Emitted when a product role is deleted.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Role deleted","type":"product.role.deleted"},{"description":"Emitted when a product role is updated or its permissions change.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Role updated","type":"product.role.updated"},{"description":"Emitted when a product user is created from a Clerk webhook.","group_name":"CLERK","group_type":"integration","name":"Clerk user created","type":"clerk.user.created"},{"description":"Emitted when a product user is created.","group_name":"Users","group_type":"internal","name":"Product user created","type":"product_user.created"},{"description":"Emitted when a product user is deleted from a Clerk webhook.","group_name":"CLERK","group_type":"integration","name":"Clerk user deleted","type":"clerk.user.deleted"},{"description":"Emitted when a product user is deleted.","group_name":"Users","group_type":"internal","name":"Product user deleted","type":"product_user.deleted"},{"description":"Emitted when a product user is updated from a Clerk webhook.","group_name":"CLERK","group_type":"integration","name":"Clerk user updated","type":"clerk.user.updated"},{"description":"Emitted when a product user is updated.","group_name":"Users","group_type":"internal","name":"Product user updated","type":"product_user.updated"},{"description":"Emitted when a resource permission is created.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Resource permission created","type":"product.resource_permission.created"},{"description":"Emitted when a resource permission is deleted.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Resource permission deleted","type":"product.resource_permission.deleted"},{"description":"Emitted when a resource permission is updated.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Resource permission updated","type":"product.resource_permission.updated"},{"description":"Emitted when a resource type is added to the product's tree.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Resource type created","type":"product.resource_type.created"},{"description":"Emitted when a resource type is removed from the product's tree.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Resource type deleted","type":"product.resource_type.deleted"},{"description":"Emitted when a resource type is renamed, or its parent types or nesting change.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Resource type updated","type":"product.resource_type.updated"},{"description":"Emitted when an organization API key is created.","group_name":"API Keys","group_type":"internal","name":"API key created","type":"organization.api_key.created"},{"description":"Emitted when an organization API key is deleted.","group_name":"API Keys","group_type":"internal","name":"API key deleted","type":"organization.api_key.deleted"},{"description":"Emitted when an organization API key is updated.","group_name":"API Keys","group_type":"internal","name":"API key updated","type":"organization.api_key.updated"},{"description":"Emitted when an organization creates a custom role.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Custom role created","type":"organization.role.created"},{"description":"Emitted when an organization deletes a custom role.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Custom role deleted","type":"organization.role.deleted"},{"description":"Emitted when an organization invitation is accepted. The membership created event follows.","group_name":"Organizations","group_type":"internal","name":"Invitation accepted","type":"organization.invitation.accepted"},{"description":"Emitted when an organization invitation is created.","group_name":"Organizations","group_type":"internal","name":"Invitation created","type":"organization.invitation.created"},{"description":"Emitted when an organization invitation is deleted.","group_name":"Organizations","group_type":"internal","name":"Invitation deleted","type":"organization.invitation.deleted"},{"description":"Emitted when an organization invitation is updated.","group_name":"Organizations","group_type":"internal","name":"Invitation updated","type":"organization.invitation.updated"},{"description":"Emitted when an organization is deleted.","group_name":"Organizations","group_type":"internal","name":"Organization deleted","type":"organization.deleted"},{"description":"Emitted when an organization license is instantiated, adjusted, or migrated.","group_name":"Licensing","group_type":"internal","name":"Organization license updated","type":"organization.license.updated"},{"description":"Emitted when an organization member is removed.","group_name":"Organizations","group_type":"internal","name":"Membership deleted","type":"organization.membership.deleted"},{"description":"Emitted when an organization member's role is updated.","group_name":"Organizations","group_type":"internal","name":"Membership updated","type":"organization.membership.updated"},{"description":"Emitted when an organization's custom role or its permissions change.","group_name":"Roles \u0026 Permissions","group_type":"internal","name":"Custom role updated","type":"organization.role.updated"},{"description":"Emitted when an organization's details are updated.","group_name":"Organizations","group_type":"internal","name":"Organization updated","type":"organization.updated"}]}

