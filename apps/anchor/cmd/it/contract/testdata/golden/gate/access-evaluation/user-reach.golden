request-body: {"subject": {"type": "user", "id": "{{dev-member.externalId}}"}, "resource": {"type": "organization", "id": "{{echopointOrgId}}"}}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/access-evaluation/user-reach
header-names: Content-Type, Vary, X-Request-Id

body:
