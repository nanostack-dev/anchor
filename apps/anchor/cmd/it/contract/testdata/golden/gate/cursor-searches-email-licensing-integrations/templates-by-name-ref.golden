# anchor: cursor searches — email & licensing & integrations / Email templates by name (all tie): one page of 3 holds the scope (200)
request: POST /v1/products/{{create-product.productId}}/email/templates/search
request-headers: Authorization, Content-Type
request-body: {"sort_by":"name","sort_direction":"ASC","pagination":{"limit":100}}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/cursor-searches-email-licensing-integrations/templates-by-name-ref
