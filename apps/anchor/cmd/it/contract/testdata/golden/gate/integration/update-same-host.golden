# anchor: integration / Update SMTP same host, no password (200, kept)
request: PUT /v1/products/{{create-product.productId}}/integrations/{{create-integration.iid}}
request-headers: Authorization, Content-Type
request-body: {"config": {"host": "smtp.example.com", "port": 587, "encryption": "STARTTLS", "auth_method": "LOGIN", "username": "u", "from_address": "{{create-integration.fromAddress}}", "from_name": "Ep Test Same Host"}}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/integration/update-same-host
header-names: Content-Type, Vary, X-Request-Id

body:
{"config_version":1,"created_at":"<timestamp.frac>","id":"{{create-integration.iid}}","is_enabled":false,"last_error":"<smtp check: not configured or connection failed>","product_id":"{{create-product.productId}}","provider_type":"SMTP","public_config":{"auth_method":"LOGIN","encryption":"STARTTLS","from_address":"{{create-integration.fromAddress}}","from_name":"Ep Test Same Host","host":"smtp.example.com","port":587,"username":"u"},"status":"INACTIVE","updated_at":"<timestamp.frac>"}

