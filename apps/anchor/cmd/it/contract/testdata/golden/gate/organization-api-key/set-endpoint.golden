# anchor: organization-api-key / Point Product Events At The Run Webhook (200)
request: PUT /v1/products/{{create-product.productId}}
request-headers: Authorization, Content-Type
request-body: {"name":"eptest-orgkey-{{$runId}}","config":{"events":{"endpoint_url":"{{webhook.url}}"}}}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/organization-api-key/set-endpoint
header-names: Content-Type, Vary, X-Request-Id

body:
