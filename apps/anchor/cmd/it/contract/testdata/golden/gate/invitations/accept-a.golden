# anchor: invitations / Accept A
request: POST /v1/products/{{create-product.productId}}/organizations/{{create-org.orgId}}/invitations/{{invite-a.invitationId}}/accept
request-headers: Content-Type, X-Product-Api-Key
request-body: {"product_user_id": "{{create-invitee.userId}}"}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/invitations/accept-a
header-names: Content-Type, Vary, X-Request-Id

body:
{"accepted_at":"<timestamp.frac>","created_at":"<timestamp.frac>","email":"{{invite-a.email}}","expires_at":"{{$isoTimestamp:+720h}}","id":"{{invite-a.invitationId}}","organization_id":"{{create-org.orgId}}","role_id":"{{create-role-two.roleId}}","status":"accepted","updated_at":"<timestamp.frac>"}

