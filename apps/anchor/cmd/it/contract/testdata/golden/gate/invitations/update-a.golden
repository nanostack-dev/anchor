# anchor: invitations / Change A's Role And Expiry
request: PUT /v1/products/{{create-product.productId}}/organizations/{{create-org.orgId}}/invitations/{{invite-a.invitationId}}
request-headers: Content-Type, X-Product-Api-Key
request-body: {"role_id":"{{create-role-two.roleId}}","expires_at":"{{$isoTimestamp:+720h}}","email":"garbage+intruder@nanostack.dev"}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/invitations/update-a
header-names: Content-Type, Vary, X-Request-Id

body:
{"created_at":"<timestamp.frac>","email":"{{invite-a.email}}","expires_at":"{{$isoTimestamp:+720h}}","id":"{{invite-a.invitationId}}","organization_id":"{{create-org.orgId}}","role_id":"{{create-role-two.roleId}}","status":"pending","updated_at":"<timestamp.frac>"}

