# anchor: register on assign & organization role scope / Org role scope · Change the invitation's role to project-admin → 400 ROLE_NOT_ORGANIZATION_SCOPED
request: PUT /v1/products/{{create-product.productId}}/organizations/{{create-org.orgId}}/invitations/{{scope-invite-ok.id}}
request-headers: Authorization, Content-Type
request-body: {"role_id": "{{role-project-admin.id}}", "expires_at": "{{scope-invite-ok.expiresAt}}"}

status: 400
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/register-on-assign-organization-role-scope/scope-invite-update
header-names: Content-Type, Vary, X-Request-Id

body:
{"errors":[{"code":"ROLE_NOT_ORGANIZATION_SCOPED","message":"An Organization role must be scoped to organization. This role is scoped to project: assign it on a resource instead.","metadata":{"resource_type":"project","role_id":"{{role-project-admin.id}}"}}]}

