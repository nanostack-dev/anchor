# anchor: access evaluation / Product Key Without Read Scopes (403)
request: POST /v1/products/{{create-product.productId}}/access/v1/evaluation
request-headers: Content-Type, X-Product-Api-Key
request-body: {"subject": {"type": "organization_api_key", "id": "{{okey.value}}"}, "resource": {"type": "organization"}, "action": {"name": "acc:read"}}

status: 403
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/access-evaluation/no-scope
header-names: Content-Type, Vary, X-Request-Id

body:
{"errors":[{"code":"PRODUCT_API_KEY_INSUFFICIENT_PERMISSIONS","message":"The product API key does not have sufficient permissions.","metadata":{"api_key_id":"product_apikey_<id>","current_scopes":["product_user:read"],"required_scopes":["organization_api_key:read"]}}]}

logs: 0 line(s)
