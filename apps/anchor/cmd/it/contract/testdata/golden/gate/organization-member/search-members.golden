# anchor: organization-member / Search Members By User, Email And Role
request: POST /v1/products/{{create-product.productId}}/organizations/{{create-org.orgId}}/members/search
request-headers: Content-Type, X-Product-Api-Key
request-body: {"filter":{"product_user_ids":["{{create-member-user.uid}}"],"emails":["{{create-member-user.email}}"],"role_ids":["{{create-role-one.r1}}"]}}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/organization-member/search-members
header-names: Content-Type, Vary, X-Request-Id

body:
{"count":1,"items":[{"email":"{{create-member-user.email}}","joined_at":"<timestamp.frac>","name":"{{$fullName}}","product_user_id":"{{create-member-user.uid}}","role":{"id":"{{create-role-one.r1}}","name":"eptest-mrole-one"}}],"total":1}

logs: 1 line(s)
{"api_key_id":"product_apikey_<id>","api_key_name":"eptest-member-key","bytes_out":"<int:=body-length>","caller":"/<path>/<file>.go:<line>","client_ip":"<ip>","duration":"<duration:number:ms>","env":"development","level":"info","message":"POST /v1/products/{{create-product.productId}}/organizations/{{create-org.orgId}}/members/search -> 200 (<duration>)","method":"POST","path":"/v1/products/{{create-product.productId}}/organizations/{{create-org.orgId}}/members/search","principal_type":"api_key","request_body":"<present>","request_id":"ct/organization-member/search-members","status":200,"tenant_id":"tenant_<id>","time":"<time:timestamp>","user_agent":"anchor-contract/1"}
