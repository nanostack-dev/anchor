# anchor: product-user / Search By Email Finds The Invited User (200)
request: POST /v1/products/{{create-product.productId}}/product-users/search
request-headers: Content-Type, X-Product-Api-Key
request-body: {"filter":{"emails":["garbage+eptest-u2-{{$runId}}@nanostack.dev"]}}

status: 200
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/product-user/search-users
header-names: Content-Type, Vary, X-Request-Id

body:
