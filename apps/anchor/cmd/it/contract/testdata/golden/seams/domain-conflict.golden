# duplicate product name: 409 envelope
request: POST /v1/products
request-headers: Authorization, Content-Type
request-body: {"name":"contract-seams-{{$runId}}"}

status: 409
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/seams/domain-conflict
header-names: Content-Type, Vary, X-Request-Id

body:
{"errors":[{"code":"PRODUCT_ALREADY_EXISTS","message":"A product with this name already exists in your tenant."}]}

