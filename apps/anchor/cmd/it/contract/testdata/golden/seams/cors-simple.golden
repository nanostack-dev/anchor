# CORS headers on an authenticated GET
request: GET /v1/products/{{product}}
request-headers: Authorization, Content-Type, Origin

status: 200
header Access-Control-Allow-Credentials: true
header Access-Control-Allow-Origin: *
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/seams/cors-simple
header Access-Control-Expose-Headers: Link, Deprecation
header-names: Access-Control-Allow-Credentials, Access-Control-Allow-Origin, Access-Control-Expose-Headers, Content-Type, Vary, X-Request-Id

body:
{"config":{"organization_api_keys":{"prefix":"anchor"},"protected":false},"created_at":"<timestamp.frac>","description":"golden contract suite","id":"{{product}}","name":"contract-seams-{{$runId}}","tenant_id":"tenant_<id>","updated_at":"<timestamp.frac>"}

logs: 1 line(s)
{"bytes_out":"<int:=body-length>","caller":"/<path>/<file>.go:<line>","client_ip":"<ip>","duration":"<duration:number:ms>","env":"development","level":"info","message":"GET /v1/products/{{product}} -> 200 (<duration>)","method":"GET","path":"/v1/products/{{product}}","principal_type":"user","request_id":"ct/seams/cors-simple","status":200,"tenant_id":"tenant_<id>","time":"<time:timestamp>","user_agent":"anchor-contract/1","user_id":"user_<id>"}
