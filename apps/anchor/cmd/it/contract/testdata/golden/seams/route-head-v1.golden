# HEAD on a GET operation
request: HEAD /v1/products/{{product}}
request-headers: Authorization, Content-Type

status: 405
header Content-Type: text/plain; charset=utf-8
header Vary: Origin
header X-Content-Type-Options: nosniff
header X-Request-Id: ct/seams/route-head-v1
header-names: Content-Type, Vary, X-Content-Type-Options, X-Request-Id

body:

logs: 0 line(s)
