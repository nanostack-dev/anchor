# 201 success shape and the owner's log enrichment
request: POST /v1/products
request-headers: Authorization, Content-Type
request-body: {"name":"contract-seams-{{$runId}}","description":"golden contract suite"}

status: 201
header Content-Type: application/json
header Vary: Origin
header X-Request-Id: ct/seams/product-create
