        {
         "operator_data": {
          "value": "{{create-user.uid}}"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.data.product_user_id"
         },
         "extractor_type": "json_path"
        }
       ]
      },
      {
       "max": 0,
       "min": 0,
       "name": "U2 never deleted",
       "assertions": [
        {
         "operator_data": {
          "value": "product_user.deleted"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.type"
         },
         "extractor_type": "json_path"
        },
        {
