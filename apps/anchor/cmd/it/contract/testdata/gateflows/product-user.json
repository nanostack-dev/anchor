        {
         "operator_data": {
          "value": "product_user.created"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.type"
         },
         "extractor_type": "json_path"
        },
        {
         "operator_data": {
          "value": "{{create-member-user.uid}}"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.data.product_user_id"
         },
         "extractor_type": "json_path"
        }
       ]
      },
      {
       "max": 1,
       "min": 1,
       "name": "U1 deleted once (the idempotent second delete emits nothing)",
       "assertions": [
        {
         "operator_data": {
          "value": "product_user.deleted"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.type"
