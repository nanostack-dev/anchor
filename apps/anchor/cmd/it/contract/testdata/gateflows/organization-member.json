          "value": "{{create-member-user.uid}}"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.data.product_user_id"
         },
         "extractor_type": "json_path"
        }
       ]
      },
      {
       "max": 0,
       "min": 0,
       "name": "Outsider never joins",
       "assertions": [
        {
         "operator_data": {
          "value": "organization.membership.created"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.type"
         },
         "extractor_type": "json_path"
        },
        {
         "operator_data": {
          "value": "{{create-outsider.uid}}"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.data.product_user_id"
         },
         "extractor_type": "json_path"
        }
       ]
      },
      {
       "max": 1,
       "min": 0,
       "name": "No other membership created",
       "assertions": [
        {
         "operator_data": {
          "value": "organization.membership.created"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.type"
         },
         "extractor_type": "json_path"
        }
       ]
      },
      {
       "max": 1,
       "min": 0,
       "name": "No other membership updated",
       "assertions": [
        {
         "operator_data": {
          "value": "organization.membership.updated"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.type"
         },
         "extractor_type": "json_path"
        }
       ]
      },
      {
       "max": 1,
       "min": 0,
       "name": "No other membership deleted",
       "assertions": [
        {
         "operator_data": {
          "value": "organization.membership.deleted"
         },
         "operator_type": "equals",
         "extractor_data": {
          "path": "$.type"
         },
         "extractor_type": "json_path"
        }
       ]
      }
     ],
     "settle_ms": 3000,
     "timeout_ms": 30000
    },
    "type": "webhook_wait",
    "run_when": "always",
    "assertions": [
     {
      "operator_data": {
       "value": "v1,"
      },
      "operator_type": "starts_with",
      "extractor_data": {
       "header_name": "webhook-signature"
      },
      "extractor_type": "header"
     },
     {
      "operator_data": {
       "value": "anchor_"
      },
      "operator_type": "not_contains",
      "extractor_data": {},
      "extractor_type": "body"
     }
    ],
    "display_name": "Anchor Emitted Every Membership Event"
   },
   {
    "id": "cleanup",
    "data": {
     "url": "{{nanostackBaseUrl}}/v1/products/{{create-product.productId}}",
     "method": "DELETE",
     "headers": {
      "Content-Type": "application/json",
