    "assertions": [
     {
      "operator_data": {
       "value": "204"
      },
      "operator_type": "equals",
      "extractor_data": {},
      "extractor_type": "status_code"
     }
    ],
    "display_name": "Cleanup Product"
   }
  ],
  "version": ""
 }
