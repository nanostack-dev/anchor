   {
    "id": "create-product",
    "data": {
     "url": "{{nanostackBaseUrl}}/v1/products",
     "body": "{\"name\":\"eptest-evt-{{$runId}}\",\"description\":\"event delivery suite\",\"config\":{\"events\":{\"endpoint_url\":\"{{webhook.url}}\",\"events\":[\"organization.created\",\"organization.updated\"]}}}",
     "method": "POST",
     "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer {{login.authToken}}"
     }
    },
    "type": "request",
    "outputs": [
     {
      "name": "productId",
      "secret": false,
      "extractor": {
       "path": "$.id",
       "type": "json_path"
      }
     },
     {
      "name": "secret",
      "secret": false,
      "extractor": {
       "path": "$.config.events.signing_secret",
       "type": "json_path"
      }
     }
    ],
    "run_when": "on_success",
    "assertions": [
     {
      "operator_data": {
       "value": "201"
      },
      "operator_type": "equals",
      "extractor_data": {},
      "extractor_type": "status_code"
     },
     {
      "operator_data": {
       "value": "/webhook/"
      },
      "operator_type": "contains",
      "extractor_data": {
       "path": "$.config.events.endpoint_url"
      },
      "extractor_type": "json_path"
     },
     {
      "operator_data": {
       "value": "^whsec_[A-Za-z0-9+/]{43}=$"
      },
      "operator_type": "regex",
      "extractor_data": {
       "path": "$.config.events.signing_secret"
      },
      "extractor_type": "json_path"
     },
     {
      "operator_data": {
       "value": "*"
      },
      "operator_type": "contains",
      "extractor_data": {
       "path": "$.config.events.signing_secret_obfuscated"
      },
      "extractor_type": "json_path"
     },
     {
      "operator_data": {
       "value": "organization.created"
      },
      "operator_type": "equals",
      "extractor_data": {
       "path": "$.config.events.events[0]"
      },
      "extractor_type": "json_path"
     },
     {
      "operator_data": {
       "value": "organization.updated"
      },
      "operator_type": "equals",
      "extractor_data": {
       "path": "$.config.events.events[1]"
      },
      "extractor_type": "json_path"
     },
     {
      "operator_data": {
       "value": "never_attempted"
      },
      "operator_type": "equals",
      "extractor_data": {
       "path": "$.config.events.delivery_status"
      },
      "extractor_type": "json_path"
     },
     {
      "operator_data": {
       "value": "0"
      },
      "operator_type": "equals",
      "extractor_data": {
       "path": "$.config.events.consecutive_failed_calls"
      },
      "extractor_type": "json_path"
     },
     {
      "operator_data": {
       "value": "eptest-evt-{{$runId}}"
      },
      "operator_type": "equals",
      "extractor_data": {
       "path": "$.name"
      },
      "extractor_type": "json_path"
     }
    ],
    "display_name": "Create Product Subscribed To Two Types (201)"
   },
