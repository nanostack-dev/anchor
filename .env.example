# Anchor Environment Configuration
# Copy this file to .env and update the values

# ==== REQUIRED VARIABLES ====
# These MUST be set for the application to work

# Database Configuration
POSTGRES_USER=anchor
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_DB=anchor

# JWT Secret for Authentication (use a long, random string)
ADMIN_JWT_SECRET=change_this_to_a_very_long_random_secret_key_for_jwt_signing

# ==== OPTIONAL VARIABLES ====
# These have defaults but can be customized

# Application Environment
ENVIRONMENT=production

# Server Configuration
SERVER_PORT=8080

# Database Connection Settings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Token Lifetimes (in seconds)
REFRESH_TOKEN_LIFETIME=84600
ACCESS_TOKEN_LIFETIME=3600

# ==== DEVELOPMENT/BUILD CONFIGURATION ====
# Uncomment these for development/testing

# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# ENVIRONMENT=development
# SERVER_PORT=8080

# GitHub Token for accessing private repositories during Docker build
# Only needed if your application depends on private GitHub repositories
# GITHUB_TOKEN=your_github_personal_access_token_here